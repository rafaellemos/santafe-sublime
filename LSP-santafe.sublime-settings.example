// Copie este objeto para Preferences > Package Settings > LSP > Settings,
// depois de instalar o pacote LSP pelo Package Control.
{
    "Santafé": {
        "enabled": true,
        "command": ["santafé-sls"],
        "selector": "source.santafe",
        "schemes": ["file", "buffer"],
        "diagnostics_mode": "workspace"
    }
}
