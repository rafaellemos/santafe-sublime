[
    {
        "id": "preferences",
        "children": [
            {
                "id": "package-settings",
                "children": [
                    {
                        "caption": "Santafé",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": {"base_file": "${packages}/Santafe/Santafe.sublime-settings"}
                            },
                            {
                                "caption": "Key Bindings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/Santafe/Default.sublime-keymap",
                                    "default": "[\n\t$0\n]\n"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
