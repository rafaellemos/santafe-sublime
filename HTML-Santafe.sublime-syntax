%YAML 1.2
---
# Herança mantém o HTML do editor, sem clonar milhares de contextos com
# with_prototype (HTML -> JS -> templates HTML cria recursão no build 4215).
scope: text.html.santafe-template
version: 2
hidden: true
extends: Packages/HTML/HTML.sublime-syntax
contexts:
  prototype:
    - meta_prepend: true
    - include: interpolacoes-santafe
  interpolacoes-santafe:
    - include: scope:source.santafe#escape-colar
    - include: scope:source.santafe#interpolação
  tag-attribute-value-content:
    - meta_prepend: true
    - include: interpolacoes-santafe
  strings-common-content:
    - meta_prepend: true
    - include: interpolacoes-santafe
  script-javascript-content:
    - meta_include_prototype: false
    - match: '{{script_content_begin}}'
      pop: 1
      embed: scope:source.js.santafe-template
      embed_scope: source.js.embedded.html
      escape: '{{script_content_end}}'
